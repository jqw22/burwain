# Copy to .env.local and fill in from Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Signed-in end-to-end tests against a local Supabase (`npx supabase start` in the repo root).
# Use the local API URL and publishable key above, then set:
# E2E_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# E2E_MAILPIT_URL=http://127.0.0.1:54324
# E2E_SCREENSHOTS=screenshots   # optional
