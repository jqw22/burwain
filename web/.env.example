# Copy to .env.local and fill in from Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Signed-in end-to-end tests against a local Supabase (`npx supabase start` in the repo root).
# Use the local API URL and publishable key above, then set:
# E2E_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# E2E_MAILPIT_URL=http://127.0.0.1:54324
# E2E_SCREENSHOTS=screenshots   # optional

# Sending club emails (renewal reminders) through Resend. Server-only: set these in Netlify, never NEXT_PUBLIC_.
RESEND_API_KEY=            # from resend.com > API Keys; leave blank to keep sending switched off
EMAIL_FROM=                # e.g. Burwain Membership <membership@burwain.co.uk> (must be on the verified domain)
EMAIL_REPLY_TO=            # optional: where replies go; defaults to EMAIL_FROM

# Card payments with Stripe. Server-only: set these in Netlify, never NEXT_PUBLIC_.
# Until STRIPE_SECRET_KEY and SUPABASE_SECRET_KEY are both set, checkout is a test checkout (no money taken).
# STRIPE_SECRET_KEY: Stripe > Developers > API keys (sk_test_... in test mode)
# STRIPE_WEBHOOK_SECRET: Stripe > Developers > Webhooks, endpoint https://<site>/api/stripe/webhook (whsec_...)
# SUPABASE_SECRET_KEY: Supabase > Project Settings > API Keys > secret key (sb_secret_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SUPABASE_SECRET_KEY=
